# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_ANON_KEY: Supabase public anon key for database and auth access.
SUPABASE_ANON_KEY=DEFAULT_ANON_KEY

# GOOGLE_MAPS_API_KEY: Google Maps SDK & Places API key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
